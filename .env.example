# GEMINI_API_KEY belongs only on the Supabase Edge Function / backend server.
# Never expose it with a VITE_ prefix or inject it into the WebView bundle.
GEMINI_API_KEY="MY_SERVER_SIDE_GEMINI_API_KEY"

# Optional endpoint that receives Smart Input text and calls Gemini server-side.
# Leave empty to use the offline local parser only.
VITE_SMART_INPUT_ENDPOINT=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth / Data
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Auth behavior:
# - strict: must login before entering app
# - guest_readonly: allow guest mode (view only, no write)
VITE_AUTH_ACCESS_MODE="strict"

# When true, user must verify email before first login
VITE_REQUIRE_EMAIL_VERIFICATION="true"

# Optional redirect for verification / reset password links
# For local web: http://localhost:3000
# For production: your app public URL
VITE_AUTH_REDIRECT_URL="http://localhost:3000"

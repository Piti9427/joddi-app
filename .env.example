VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini AI Key for Smart Input and OCR
# Get one at https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key

# Auth behavior:
# - strict: must login before entering app
# - guest_readonly: allow guest mode (view only, no write)
VITE_AUTH_ACCESS_MODE="strict"

# When true, user must verify email before first login
VITE_REQUIRE_EMAIL_VERIFICATION="false"

# Optional redirect for verification / reset password links
VITE_AUTH_REDIRECT_URL="http://localhost:3000"
